# VERTOTHON 2026 — Environment Configuration Template
# Copy this file to .env or .env.local and update with your credentials.

# Application Configuration
VITE_APP_NAME="VERTOTHON 2026 Operations Platform"
VITE_APP_ENV="development" # development | staging | production
VITE_API_URL="http://localhost:3000/api"

# Planned Capacity
VITE_MAX_PARTICIPANTS_CAPACITY="1000"

# Event Configuration (Default / Configurable values)
VITE_EVENT_NAME="VERTOTHON 2026"
VITE_EVENT_ORGANIZER="Vertofi Private Limited"
VITE_EVENT_LOCATION="Hyderabad, Telangana, India"
VITE_EVENT_DATES="November 14-15, 2026"
VITE_REGISTRATION_DEADLINE="October 31, 2026"

# Feature Flags
# Keep payment disabled until organizer approves pricing and policy
VITE_FEATURE_PAYMENTS_ENABLED="false"
VITE_FEATURE_AI_ASSISTANCE_ENABLED="false"
VITE_FEATURE_PUBLIC_REGISTRATION="true"

# Supabase / Backend Integration (Placeholder keys for development)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Database Connection (For backend service/migrations - Keep secret, never commit to git)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vertothon_db"
